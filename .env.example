# ===== REQUIRED =====
# Database connection URL (PostgreSQL in production, SQLite for local dev)
DATABASE_URL=<your-database-url>

# OTP Storage: database | redis | memory
OTP_STORAGE=<your-otp-storage-type>

# ===== APP CONFIG =====
ENV=<your-environment>
APP_NAME=<your-app-name>
API_PREFIX=<your-api-prefix>
LOG_LEVEL=<your-log-level>
FRONTEND_URL=<your-frontend-url>
CORS_ORIGINS=<your-cors-origins>

# ===== SECURITY =====
JWT_SECRET_KEY=<your-jwt-secret-key>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ===== ENCRYPTION KEYS =====
TOTP_ENCRYPTION_KEY=<your-fernet-key-base64-32-bytes>

# ===== REDIS (Required in production and staging) =====
REDIS_URL=<your-redis-url>

# ===== SENTRY (Optional, error tracking) =====
SENTRY_DSN=<your-sentry-dsn>

# ===== AWS S3 (Optional, file uploads) =====
AWS_REGION=<your-aws-region>
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
S3_BUCKET=<your-s3-bucket>
S3_PUBLIC_BASE_URL=<your-s3-public-base-url>

# ===== TWILIO (Optional, SMS notifications) =====
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
TWILIO_FROM_NUMBER=<your-twilio-from-number>

# ===== MSG91 (Optional, phone verification) =====
MSG91_AUTH_KEY=<your-msg91-auth-key>

# ===== RAZORPAY (Optional, payments) =====
RAZORPAY_KEY_ID=<your-razorpay-key-id>
RAZORPAY_KEY_SECRET=<your-razorpay-key-secret>
